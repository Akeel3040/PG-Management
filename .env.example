# PostgreSQL Connection URL (e.g. Neon, Supabase, or local PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/pg_management?schema=public"

# Session JWT secret
JWT_SECRET="replace-with-a-strong-random-secret-key"

# App public configuration
NEXT_PUBLIC_APP_NAME="PG Management System"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
UPLOAD_DIR="./public/uploads"
